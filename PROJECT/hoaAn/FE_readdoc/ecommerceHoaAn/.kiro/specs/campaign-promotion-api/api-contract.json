    {
        "id": "2.1",
        "endpoint": "POST /api/v1/campaigns/{campaignId}/promotions",
        "description": "Create a promotion for a campaign",
        "method": "POST",
        "path": "/api/v1/campaigns/camp-001/promotions",
        "featureRequirement": "2.1, 2.3",
        "requestBody": {
            "discountValue": 40,
            "discountType": "percentage",
            "startDate": "2025-01-01T00:00:00Z",
            "endDate": "2025-02-15T23:59:59Z",
            "minOrderValue": 500000,
            "maxUsage": 1000,
            "description": "40% off on all altar offerings"
        },
        "successResponse": {
            "statusCode": 200,
            "body": {
                "success": true,
                "data": {
                    "promotionId": "promo-001",
                    "campaignId": "camp-001",
                    "discountValue": 40,
                    "discountType": "percentage",
                    "startDate": "2025-01-01T00:00:00Z",
                    "endDate": "2025-02-15T23:59:59Z",
                    "minOrderValue": 500000,
                    "maxUsage": 1000,
                    "currentUsage": 0,
                    "description": "40% off on all altar offerings",
                    "createdAt": "2025-01-01T10:00:00Z"
                },
                "message": "Promotion created successfully"
            }
        },
        "errorResponses": [
            {
                "statusCode": 409,
                "scenario": "Campaign is not in DRAFT status",
                "body": {
                    "success": false,
                    "message": "Cannot add promotions to a non-DRAFT campaign",
                    "errorCode": "CAMPAIGN_NOT_DRAFT"
                }
            },
            {
                "statusCode": 400,
                "scenario": "EndDate <= StartDate",
                "body": {
                    "success": false,
                    "errors": {
                        "endDate": [
                            "End date must be after start date"
                        ]
                    },
                    "message": "Validation failed"
                }
            }
        ]
    },
