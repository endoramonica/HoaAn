    {
        "id": "3.1",
        "endpoint": "POST /api/v1/promotions/{promotionId}/vouchers/generate",
        "description": "Generate voucher codes for a promotion",
        "method": "POST",
        "path": "/api/v1/promotions/promo-001/vouchers/generate",
        "featureRequirement": "3.1",
        "requestBody": {
            "quantity": 100,
            "prefix": "TET2025",
            "expiryDate": "2025-02-15T23:59:59Z"
        },
        "successResponse": {
            "statusCode": 200,
            "body": {
                "success": true,
                "data": {
                    "vouchersGenerated": 100,
                    "promotionId": "promo-001",
                    "codes": [
                        "TET2025-ABC123",
                        "TET2025-DEF456",
                        "TET2025-GHI789"
                    ],
                    "createdAt": "2025-01-01T10:00:00Z"
                },
                "message": "100 voucher codes generated successfully"
            }
        }
    },
    {
        "id": "3.2",
        "endpoint": "POST /api/v1/cart/apply-voucher",
        "description": "Apply a voucher code to cart",
        "method": "POST",
        "path": "/api/v1/cart/apply-voucher",
        "featureRequirement": "3.2, 3.3",
        "requestBody": {
            "couponCode": "TET2025-ABC123"
        },
        "successResponse": {
            "statusCode": 200,
            "body": {
                "success": true,
                "data": {
                    "cartId": "cart-001",
                    "appliedCoupon": "TET2025-ABC123",
                    "promotionId": "promo-001",
                    "discountValue": 40,
                    "discountType": "percentage",
                    "discountAmount": 400000,
                    "subtotal": 1000000,
                    "totalAmount": 600000,
                    "message": "Voucher applied successfully"
                }
            }
        },
        "errorResponses": [
            {
                "statusCode": 400,
                "scenario": "Invalid or expired voucher code",
                "body": {
                    "success": false,
                    "message": "Voucher code is invalid or expired",
                    "errorCode": "INVALID_VOUCHER"
                }
            },
            {
                "statusCode": 409,
                "scenario": "Voucher usage limit reached",
                "body": {
                    "success": false,
                    "message": "Voucher code has reached its usage limit",
                    "errorCode": "VOUCHER_LIMIT_EXCEEDED"
                }
            },
            {
                "statusCode": 400,
                "scenario": "Cart total below minimum order value",
                "body": {
                    "success": false,
                    "message": "Cart total must be at least 500000 to use this voucher",
                    "errorCode": "MIN_ORDER_VALUE_NOT_MET"
                }
            }
        ]
    },
    {
        "id": "3.3",
        "endpoint": "POST /api/v1/cart/remove-voucher",
