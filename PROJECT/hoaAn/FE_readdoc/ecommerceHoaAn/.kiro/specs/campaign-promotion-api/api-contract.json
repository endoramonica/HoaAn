[
    {
        "id": "1.1",
        "endpoint": "POST /api/v1/campaigns",
        "description": "Create a new campaign",
        "method": "POST",
        "path": "/api/v1/campaigns",
        "featureRequirement": "1.1",
        "requestBody": {
            "campaignName": "Đại hạ giá Tết Nguyên Đán 2025",
            "budget": 50000000,
            "startDate": "2025-01-01T00:00:00Z",
            "endDate": "2025-02-15T23:59:59Z",
            "status": "DRAFT",
            "description": "Mâm cúng gia tiên, hương nến cao cấp, giấy tiền vàng bạc",
            "targeting": {
                "pages": [
                    "home",
                    "products"
                ],
                "frequency": "once-per-session",
                "delayMs": 3000,
                "autoDismissMs": 15000
            }
        },
        "successResponse": {
            "statusCode": 200,
            "body": {
                "success": true,
                "data": {
                    "campaignId": "camp-001",
                    "campaignName": "Đại hạ giá Tết Nguyên Đán 2025",
                    "budget": 50000000,
                    "startDate": "2025-01-01T00:00:00Z",
                    "endDate": "2025-02-15T23:59:59Z",
                    "status": "DRAFT",
                    "description": "Mâm cúng gia tiên, hương nến cao cấp, giấy tiền vàng bạc",
                    "targeting": {
                        "pages": [
                            "home",
                            "products"
                        ],
                        "frequency": "once-per-session",
                        "delayMs": 3000,
                        "autoDismissMs": 15000
                    },
                    "createdAt": "2025-01-01T10:00:00Z",
                    "updatedAt": "2025-01-01T10:00:00Z"
                },
                "message": "Campaign created successfully"
            }
        },
        "errorResponses": [
            {
                "statusCode": 400,
                "scenario": "EndDate <= StartDate",
                "body": {
                    "success": false,
                    "errors": {
                        "endDate": [
                            "End date must be after start date"
                        ]
                    },
                    "message": "Validation failed"
                }
            },
            {
                "statusCode": 400,
                "scenario": "Budget < 0",
                "body": {
                    "success": false,
                    "errors": {
                        "budget": [
                            "Budget must be greater than or equal to 0"
                        ]
                    },
                    "message": "Validation failed"
                }
            }
        ]
    },
